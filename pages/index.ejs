<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../secciones/head'); %> 
</head>
<body class="d-flex flex-column min-vh-100">
<main>
    <div class="container">
      <%- include('../secciones/menu'); %> 
<div class="jumbotron">
    <h1>Ejemplo EJS</h1>
    <p>EVD1SM-25ERS</p>
    <h2><%= titulo %></h2>
    <ul>
        <% heroes.forEach(function(heroe){ %>
            <li><strong><%= heroe.nombre %></strong> cuya identidad es <%= heroe.identidad %> y trabaja en <%= heroe.empresa %></li>
        <% }); %>
    </ul>
</div>
</div>

</main>
<footer class="mt-auto py-3 bg-light">
    <%- include('../secciones/footer'); %>
</footer>
</body>
</html>
